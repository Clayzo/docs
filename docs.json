{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Clayzo",
  "colors": {
    "primary": "#01adae",
    "light": "#01c9ca",
    "dark": "#019a9b"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "installation", "authentication"]
          },
          {
            "group": "Authoring",
            "pages": [
              "authoring/agents",
              "authoring/documents",
              "authoring/interactivity",
              "authoring/fonts-and-assets",
              "authoring/previewing"
            ]
          },
          {
            "group": "Exporting",
            "pages": ["exporting/media", "exporting/bundles"]
          },
          {
            "group": "Playback on the web",
            "pages": [
              "playback/choosing-a-renderer",
              "playback/webgl-player",
              "playback/canvaskit-player",
              "playback/react"
            ]
          },
          {
            "group": "Help",
            "pages": ["troubleshooting"]
          }
        ]
      },
      {
        "tab": "CLI reference",
        "groups": [
          {
            "group": "CLI reference",
            "pages": [
              "cli/overview",
              "cli/init",
              "cli/preview",
              "cli/render-frame",
              "cli/review",
              "cli/package",
              "cli/export",
              "cli/doctor",
              "cli/auth"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "App",
          "href": "https://app.clayzo.com",
          "icon": "arrow-up-right-from-square"
        },
        {
          "anchor": "npm",
          "href": "https://www.npmjs.com/package/clayzo",
          "icon": "npm"
        },
        {
          "anchor": "Agent skills",
          "href": "https://github.com/Clayzo/agent-skills",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:team@clayzo.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://app.clayzo.com"
    }
  },
  "contextual": {
    "options": ["copy", "claude", "chatgpt", "cursor"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/useclayzo",
      "github": "https://github.com/Clayzo"
    }
  }
}
